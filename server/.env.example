# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Replace with your own connection string e.g. MongoDB Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/eventhub_db

# JSON Web Token Secret & Expiration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173
